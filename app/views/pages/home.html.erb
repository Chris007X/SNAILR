<% content_for :head do %>
  <style>
    header { display: none; }
    #main-content { padding: 0; margin: 0; }
  </style>
<% end %>

<div class="landing-page">
  <div class="landing-container">

    <div class="brand-section">
      <div class="brand-wordmark">Snail<span class="brand-r">-R</span></div>
    </div>

    <div class="mascot-wrapper">
      <div class="mascot-ring">
        <div class="mascot-circle">
          <span class="mascot-emoji">🌀</span>
        </div>
      </div>
      <div class="mascot-glow"></div>
    </div>

    <div class="hero-text">
      <h2 class="hero-headline">Maîtrisez votre temps.</h2>
      <p class="hero-description">
        Snail-R est l'application de productivité consciente qui vous ralentit pour mieux avancer.
        Planifiez avec intention, prenez du recul chaque jour, et accomplissez davantage — un pas délibéré à la fois.
      </p>
    </div>

    <div class="feature-pills">
      <span class="pill">⏱ Suivi du temps</span>
      <span class="pill">🎯 Objectifs ciblés</span>
      <span class="pill">📊 Statistiques</span>
    </div>

    <div class="cta-section">
      <%= link_to (user_signed_in? ? objectives_path : new_user_registration_path), class: "btn-cta btn-signup" do %>
        <%= user_signed_in? ? "Commencer" : "Commencer — Inscrivez-vous" %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      <% end %>

      <% unless user_signed_in? %>
        <%= link_to "Connexion", new_user_session_path, class: "btn-cta btn-login" %>
      <% end %>
    </div>

    <p class="footer-note">Aucune carte bancaire requise &nbsp;·&nbsp; Gratuit pour commencer</p>

  </div>
</div>
