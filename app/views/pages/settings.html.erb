<% content_for :head do %>
  <style>
    header { display: none; }
    #main-content { padding: 0; margin: 0; }
  </style>
<% end %>

<div class="snail-app-layout">
  <div class="app-container">

    <section class="hero-dashboard">
      <h1 class="headline">Paramètres.</h1>
      <p class="subheadline">Configurez votre expérience Snail-R.</p>
    </section>

    <!-- Notifications -->
    <section class="settings-section">
      <h3 class="section-label">Notifications</h3>
      <div class="settings-group">
        <div class="settings-row">
          <div class="settings-row-info">
            <span class="settings-row-title">Rappels quotidiens</span>
            <span class="settings-row-desc">Recevez un rappel quotidien pour revoir vos objectifs</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
        <div class="settings-row">
          <div class="settings-row-info">
            <span class="settings-row-title">Alertes d'étapes terminées</span>
            <span class="settings-row-desc">Soyez notifié quand une étape est marquée comme terminée</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
      </div>
    </section>

    <!-- Appearance -->
    <section class="settings-section">
      <h3 class="section-label">Apparence</h3>
      <div class="settings-group">
        <div class="settings-row">
          <div class="settings-row-info">
            <span class="settings-row-title">Mode sombre</span>
            <span class="settings-row-desc">Passer à une interface plus sombre</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
        <div class="settings-row">
          <div class="settings-row-info">
            <span class="settings-row-title">Couleur d'accent</span>
            <span class="settings-row-desc">Personnaliser la couleur de mise en valeur</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
      </div>
    </section>

    <!-- Data -->
    <section class="settings-section">
      <h3 class="section-label">Données et confidentialité</h3>
      <div class="settings-group">
        <div class="settings-row">
          <div class="settings-row-info">
            <span class="settings-row-title">Exporter mes données</span>
            <span class="settings-row-desc">Télécharger tous vos objectifs et étapes</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
        <div class="settings-row settings-row-danger">
          <div class="settings-row-info">
            <span class="settings-row-title">Supprimer mon compte</span>
            <span class="settings-row-desc">Supprimer définitivement votre compte et toutes vos données</span>
          </div>
          <span class="settings-badge-soon">Bientôt disponible</span>
        </div>
      </div>
    </section>

  </div>
</div>
